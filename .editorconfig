root = true

[*]
indent_style = space
indent_size = 2
tab_width = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.mak]
indent_style = tab

[Makefile]
indent_style = tab

[*.conf]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
indent_size = 1
