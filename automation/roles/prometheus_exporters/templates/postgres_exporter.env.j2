# Managed by Autobase (prometheus_exporters role)
{% set db_password = patroni_superuser_password if prometheus_exporters_db_user == patroni_superuser_username else prometheus_exporters_db_password %}
{% set dsn = 'host=' ~ postgresql_unix_socket_dir ~ ' port=' ~ postgresql_port ~ ' sslmode=disable'
  ~ " dbname='" ~ (postgres_exporter_dbname | default('postgres', true) | replace('\\', '\\\\') | replace("'", "\\'")) ~ "'"
  ~ " user='" ~ (prometheus_exporters_db_user | replace('\\', '\\\\') | replace("'", "\\'")) ~ "'"
  ~ " password='" ~ (db_password | replace('\\', '\\\\') | replace("'", "\\'")) ~ "'" %}
DATA_SOURCE_NAME="{{ dsn | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') | replace('`', '\\`') }}"
