# Managed by Autobase (prometheus_exporters role)
{% set db_password = patroni_superuser_password if prometheus_exporters_db_user == patroni_superuser_username else prometheus_exporters_db_password %}
{% set user = prometheus_exporters_db_user | urlencode | replace('/', '%2F') %}
{% set password = db_password | urlencode | replace('/', '%2F') %}
PGBOUNCER_EXPORTER_CONNECTION_STRING="postgres://{{ user }}:{{ password }}@/pgbouncer?host={{ item.pgbouncer_socket_dir | urlencode | replace('/', '%2F') }}&port={{ pgbouncer_listen_port | default(6432) }}&sslmode=disable"
