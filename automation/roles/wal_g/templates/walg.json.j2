{% set config = {} %}
{% for setting in wal_g_json %}
{%   set value = setting.value | string %}
{%   if shard_id is defined and setting.option is match('^WALG_.*_PREFIX$') %}
{%     set value = value.rstrip('/') ~ '/' ~ patroni_scope %}
{%   endif %}
{%   set _ = config.update({setting.option: value}) %}
{% endfor %}
{{ config | to_nice_json }}
